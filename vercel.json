{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/invitations/:token*",
      "destination": "/invite"
    },
    {
      "source": "/invite/:token*",
      "destination": "/invite"
    },
    {
      "source": "/billing/paymob/redirect",
      "destination": "/paymob-redirect"
    },
    {
      "source": "/api/billing/paymob/redirect",
      "destination": "/paymob-redirect"
    }
  ],
  "redirects": [
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
