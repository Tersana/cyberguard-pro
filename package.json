  "dependencies": {
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "laravel-echo": "^2.3.4",
    "pusher-js": "^8.5.0"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "nodemon": "^3.0.1",
    "vitest": "^4.1.2"
  }
